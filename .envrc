# direnv
#   direnv란 이 디렉토리에 진입하면 자동으로 환경 변수를 설정해주는 도구입니다.
# 설치(Ubuntu, Zsh 기준):
#   sudo apt-get update && sudo apt-get install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
#   source ~/.zshrc
# 사용법:
#   1. 터미널에서 해당 디렉토리로 이동하여 `direnv allow` 명령어를 실행합니다.
#   2. 디렉토리에 진입할 때마다 환경 변수가 자동으로 설정됩니다.
export AWS_PROFILE=morton-mfa
export AWS_REGION=ap-northeast-2

# gcloud를 Morton 전용 설정 디렉토리로 격리
#   - 개인 계정(~/.config/gcloud)과 분리
#   - 최초 1회: gcloud auth login morton.career@gmail.com
#              gcloud auth application-default login
#              gcloud config set project bconnect-f0bee
export CLOUDSDK_CONFIG=$HOME/.config/gcloud-morton

# 워크트리별 dev 서버 포트 자동 할당
#   공식의 단일 정의는 scripts/dev-port.sh — 여기서는 셸 편의용으로 export만 합니다.
#   (direnv 없이 pnpm dev:career만 실행해도 스크립트 폴백으로 같은 포트가 계산됩니다)
export CAREER_PORT="$("$PWD/scripts/dev-port.sh" career)"
export PLAN_PORT="$("$PWD/scripts/dev-port.sh" plan)"