{
  "name": "@bconnect/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bundle": "redocly bundle src/spec/openapi.yaml -o src/openapi.bundled.yaml",
    "lint": "redocly lint src/spec/openapi.yaml",
    "generate": "pnpm bundle && orval",
    "generate:watch": "orval --watch"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-query-devtools": "^5.80.0",
    "ky": "^1.8.1",
    "msw": "catalog:"
  },
  "devDependencies": {
    "@redocly/cli": "^2.30.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "orval": "^8.9.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
