{
  "name": "@bconnect/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bundle": "redocly bundle src/spec/openapi.yaml -o src/openapi.bundled.yaml",
    "lint": "redocly lint src/spec/openapi.yaml",
    "generate": "pnpm bundle && orval",
    "generate:watch": "orval --watch"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-query-devtools": "^5.80.0",
    "ky": "^1.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@redocly/cli": "^2.30.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "msw": "^2.13.6",
    "orval": "^7.7.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
