{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@morton/ui": ["../ui/src/index.ts"],
      "@morton/ui/*": ["../ui/src/*"]
    }
  },
  "include": [".storybook/**/*", "../ui/src/**/*.stories.tsx"],
  "exclude": ["node_modules", "storybook-static"]
}
