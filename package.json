{
  "name": "morton",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm api:generate",
    "prepare": "husky",
    "dev": "pnpm --filter morton-career --filter morton-plan dev",
    "dev:career": "pnpm --filter morton-career dev",
    "dev:plan": "pnpm --filter morton-plan dev",
    "build": "pnpm --filter morton-career --filter morton-plan build",
    "build:career": "pnpm --filter morton-career build",
    "build:plan": "pnpm --filter morton-plan build",
    "lint": "pnpm --filter morton-career --filter morton-plan lint",
    "lint:career": "pnpm --filter morton-career lint",
    "lint:plan": "pnpm --filter morton-plan lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "pnpm --filter @morton/api-client generate",
    "storybook": "pnpm --filter @morton/storybook storybook",
    "build-storybook": "pnpm --filter @morton/storybook build-storybook",
    "figma:connect": "figma connect publish",
    "figma:connect:dry": "figma connect publish --dry-run"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@figma/code-connect": "^1.3.12",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write"
  }
}
