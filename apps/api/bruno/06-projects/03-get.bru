meta {
  name: 프로젝트 단건 조회
  type: http
  seq: 3
  tags: [
    chain
  ]
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}
  body: none
  auth: inherit
}

vars:pre-request {
  projectId: 200
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.be.a('number');
  });
}

docs {
  사용자가 소속된 업체의 프로젝트 단건 조회
  @chain
  - 05-companies/01-create
  - 06-projects/01-create
}
