meta {
  name: 프로젝트 생성
  type: http
  seq: 1
  tags: [
    chain
  ]
}

post {
  url: {{baseUrl}}/api/v1/projects
  body: json
  auth: inherit
}

body:json {
  {
    "title": "프로젝트",
    "address": {
      "zipcode": "00000",
      "state": "경기",
      "city": "수원시 장안구",
      "street": "도로명주소",
      "detail": "상세주소",
      "latitude": 37.294000,
      "longitude": 126.974000
    }
  }
}

script:post-response {
  bru.setVar("projectId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

