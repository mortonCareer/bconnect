meta {
  name: 제안 생성
  type: http
  seq: 1
  tags: [
    chain
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/offers
  body: json
  auth: inherit
}

body:json {
  {
    "taskId": {{projectTaskId}},
    "workerId": 2,
    "due": "2026-12-31"
  }
}

script:post-response {
  bru.setVar("offerId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

