meta {
  name: 기술자 작업 목록
  type: http
  seq: 6
  tags: [
    chain
  ]
}

get {
  url: {{baseUrl}}/api/v1/tasks
  auth: bearer
}

auth:bearer {
  token: {{accessToken2}}
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.workerTasks).to.be.an('array');
    expect(res.body.data.assigneeTasks).to.be.an('array');
  });
}

docs {
  섭외를 포함 작업 목록을 조회한다.
  @chain
  - 01-otp/04-verify-otp-login-2
}
