meta {
  name: 섭외 생성 - 승낙용
  type: http
  seq: 3
  tags: [
    chain
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/offers
  body: json
  auth: inherit
}

body:json {
  {
    "taskId": {{projectTaskId}},
    "workerId": 101
  }
}

script:post-response {
  bru.setVar("acceptOfferId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

