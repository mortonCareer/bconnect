meta {
  name: 업체 단건 조회
  type: http
  seq: 3
  tags: [
    chain
  ]
}

get {
  url: {{baseUrl}}/api/v1/companies/{{companyId}}
  auth: inherit
}

vars:pre-request {
  companyId: 200
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.be.a('number');
  });
}

docs {
  @chain
  - 05-companies/01-create
}
