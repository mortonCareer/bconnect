meta {
  name: 추천서 작성
  type: http
  seq: 7
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/recommendations
  auth: inherit
}

body {
  {
    "toId": 5,
    "content": "함께 일한 동료로서 추천합니다"
  }
}

script:post-response {
  bru.setVar("recommendationId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  로그인 유저(profile 1)가 profile 5에게 추천서를 작성한다.
  @seed members : 1, 6
  @seed profiles : 1, 5
}
