meta {
  name: 게시글 생성
  type: http
  seq: 1
  tags: [
    chain
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/posts
  body: json
  auth: inherit
}

body:json {
  {
    "taskId": {{workerTaskId}},
    "attachmentIds": [107],
    "content": "게시글"
  }
}

script:post-response {
  bru.setVar("postId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  @seed attachments : 107
  @chain
  - 11-worker-tasks/01-create-worker-task
}
