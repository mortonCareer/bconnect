meta {
  name: 크롤링 회원 상세 조회
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/crawled-members/:id
  auth: none
}

params:path {
  id: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.id).to.be.a('number');
    expect(res.body.data.credentials).to.be.an('array');
    expect(res.body.data.posts).to.be.an('array');
  });
}

docs {
  @seed crawled_members : 100
}
