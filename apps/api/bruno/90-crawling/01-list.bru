meta {
  name: 크롤링 회원 목록 조회
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/crawled-members
  auth: none
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.content).to.be.an('array');
    expect(res.body.data.content[0].thumbnails).to.be.an('array');
  });
}

docs {
  @seed crawled_members : 100
}
