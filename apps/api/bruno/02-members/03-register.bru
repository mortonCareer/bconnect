meta {
  name: 회원가입
  type: http
  seq: 3
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/members
  body: json
  auth: none
}

headers {
  X-Signup-Token: signup-token
}

body:json {
  {
    "username": "new-username",
    "name": "이름",
    "pictureId": null,
    "role": "USER"
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  발급된 Signup Token으로 회원가입한다.
  @seed signup_tokens : 100
}
