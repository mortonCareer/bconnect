meta {
  name: 지인 작업 목록 조회
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tasks/coworker?memberId=6
  auth: inherit
}

params:query {
  memberId: 6
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  동료(seed coworker 1-6)인 member 6의 작업 목록(바쁨 여부)을 조회한다.
}
