meta {
  name: 동료 요청 생성
  type: http
  seq: 1
  tags: [
    seed
    idempotent
  ]
}

post {
  url: {{baseUrl}}/api/v1/coworker-requests
  auth: inherit
}

body {
  {
    "toId": 3
  }
}

script:post-response {
  bru.setVar("coworkerRequestId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  로그인 멤버(1)가 다른 멤버(3)에게 동료 요청을 생성한다.
  @seed members : 3
}
