meta {
  name: 프로젝트 드라이브 생성
  type: http
  seq: 2
  tags: [
    chain
  ]
}

post {
  url: {{baseUrl}}/api/v1/drives
  body: json
  auth: inherit
}

body:json {
  {
    "type": "PROJECT",
    "title": "프로젝트 드라이브",
    "projectId": {{projectId}}
  }
}

script:post-response {
  bru.setVar("projectDriveId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  사용자가 소속된 업체 프로젝트의 드라이브 생성
  @chain
  - 04-companies/01-create
  - 05-projects/01-create
}
