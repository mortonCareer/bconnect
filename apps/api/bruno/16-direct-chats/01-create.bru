meta {
  name: 1:1 채팅방 생성
  type: http
  seq: 1
  tags: [
    seed
    idempotent
  ]
}

post {
  url: {{baseUrl}}/api/v1/direct-chats
  auth: inherit
}

body {
  {
    "memberId": 7
  }
}

script:post-response {
  bru.setVar("directChatId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  로그인 유저(member 1)와 member 7 간 1:1 채팅방을 생성한다. 이미 존재하면 기존 방을 반환한다(멱등).
  @seed members : 7
}
