get {
  url: {{baseUrl}}/api/v1/drives/{{projectDriveId}}/usage
  auth: inherit
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.usedBytes).to.be.a('number');
    expect(res.body.data.limitBytes).to.be.a('number');
  });
}

