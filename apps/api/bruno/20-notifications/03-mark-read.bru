meta {
  name: 알림 읽음
  type: http
  seq: 3
  tags: [
    chain
  ]
}

post {
  url: {{baseUrl}}/api/v1/notifications/{{notificationId}}/read
  auth: inherit
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  notificationId 알림을 읽음 처리한다. 다른 회원 알림은 403, 없는 알림은 404.
  @chain
  - 20-notifications/01-list
}
