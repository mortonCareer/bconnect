meta {
  name: 알림 목록 조회
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/notifications
  auth: inherit
}

script:post-response {
  if (res.body.data && res.body.data.content && res.body.data.content.length) {
    bru.setVar("notificationId", res.body.data.content[0].id);
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.content).to.be.an('array');
  });
}

docs {
  로그인 멤버의 알림을 커서 페이지로 조회한다. 첫 항목 id 를 notificationId 변수에 저장(읽음 체인용).
  각 항목: id, memberId, type, senderType, senderMember, senderCompany, message, referenceType, referenceId, read, createdAt
  senderType 은 MEMBER · COMPANY · null(시스템 알림)이고, 그에 따라 senderMember 또는 senderCompany 중 하나만 채워진다.
  message 는 NotificationType 템플릿에 발신자명을 렌더한 문구다.
  커서/limit 은 query 파라미터(옵션).
}
