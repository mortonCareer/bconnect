meta {
  name: 피드 단건 조회
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/feeds/{{postId}}
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.post.id).to.be.a('number');
  });
}

docs {
  생성한 게시글(postId)에 대응하는 피드 단건을 조회한다.
}
