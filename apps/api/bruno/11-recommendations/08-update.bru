meta {
  name: 추천서 수정
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/recommendations/{{recommendationId}}
  auth: inherit
}

body {
  {
    "content": "내용을 수정한 추천서입니다"
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  작성한 추천서(recommendationId)의 내용을 수정한다.
}
