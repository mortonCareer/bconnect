meta {
  name: 본인 자격 목록 조회
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/credentials/me
  auth: inherit
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  로그인 사용자(member 1)의 전체 자격(상태 무관)을 조회한다.
  @seed members : 1
  @seed credentials : 1, 2
}
