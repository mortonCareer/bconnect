meta {
  name: 기술자 작업 수정
  type: http
  seq: 2
  tags: [
    chain
    idempotent
  ]
}

put {
  url: {{baseUrl}}/api/v1/tasks/{{workerTaskId}}/worker
  auth: inherit
}

body {
  {
    "trades": ["TILING", "FILM_SHEET"],
    "start": "2026-06-04",
    "end": "2026-06-06",
    "title": "작업 수정",
    "memo": "메모 수정",
    "company": "업체 수정",
    "address": {
      "zipcode": "00001",
      "city": "서울특별시",
      "state": "종로구",
      "street": "성균관로 25-2",
      "detail": "상세주소",
      "latitude": 37.588000,
      "longitude": 126.993000
    }
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

