  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/verify
}

body {
  {
    "phone": "01000000002",
    "code": "000002"
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.registered).to.equal(false);
    expect(res.body.data.signupToken).to.be.a('string');
  });
}

docs {
