meta {
  name: OTP 검증 성공 - 가입된 연락처 JWT 토큰 발급
  type: http
  seq: 3
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "phone": "01000000002",
    "code": "000002"
  }
}

script:post-response {
  bru.setVar("accessToken", res.body.data.accessToken);
  bru.setVar("refreshToken", res.headers["set-cookie"][0].match(/refreshToken=([^;]+)/)[1]);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.registered).to.equal(true);
    expect(res.body.data.accessToken).to.be.a('string');
  });
}

docs {
  가입된 연락처 OTP 검증 시 JWT 토큰을 발급(로그인)한다.
  @seed otps : 101
  @seed members : 100
}
