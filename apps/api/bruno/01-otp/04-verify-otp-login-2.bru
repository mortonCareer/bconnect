meta {
  name: OTP 로그인 - 멤버 2
  type: http
  seq: 4
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/verify
}

body {
  {
    "phone": "01000000004",
    "code": "000004"
  }
}

script:post-response {
  bru.setVar("accessToken2", res.body.data.accessToken);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.registered).to.equal(true);
    expect(res.body.data.accessToken).to.be.a('string');
  });
}

docs {
  가입된 연락처 OTP 검증 시 JWT 토큰을 발급(로그인)한다.
  @seed otps : 3
  @seed members : 2
}
