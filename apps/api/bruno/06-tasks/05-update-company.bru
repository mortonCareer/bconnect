meta {
  name: 업체 작업 수정
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/tasks/{{projectTaskId}}/company
  auth: inherit
}

body {
  {
    "trades": ["TILING", "FILM_SHEET"],
    "start": "2026-06-04",
    "end": "2026-06-06",
    "title": "작업 수정",
    "requirement": "요구사항 수정",
    "memo": "메모 수정"
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}
