}

put {
  url: {{baseUrl}}/api/v1/profiles/me
  body: json
  auth: inherit
}

body:json {
  {
    "role": "FOREMAN",
    "primaryTrade": "FILM_SHEET",
    "trades": ["TILING", "FILM_SHEET"],
    "experience": 20,
    "headline": "한줄소개 수정",
    "address": {
      "zipcode": "00001",
      "state": "서울",
      "city": "종로구",
      "street": "성균관로 25-2",
      "detail": "상세주소",
      "latitude":  37.588000,
      "longitude": 126.993000
    }
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

