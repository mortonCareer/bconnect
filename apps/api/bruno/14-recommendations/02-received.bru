meta {
  name: 받은 추천서 목록 조회
  type: http
  seq: 2
  tags: [
    seed
  ]
}

get {
  url: {{baseUrl}}/api/v1/recommendations/received?memberId={{memberId}}
}

params:query {
  memberId: {{memberId}}
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  다른 멤버({{memberId}})가 받은 추천서 목록을 조회한다.
}
