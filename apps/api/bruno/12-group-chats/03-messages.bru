meta {
  name: 채팅 메시지 조회
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/group-chats/{{chatId}}/messages
  auth: inherit
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.content).to.be.an('array');
  });
}

docs {
  생성한 채팅방(chatId)의 메시지를 커서 페이지로 조회한다.
}
