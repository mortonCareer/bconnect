meta {
  name: 채팅방 생성
  type: http
  seq: 1
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/group-chats
  body: json
  auth: inherit
}

body:json {
  {
    "participantIds": [1, 7],
    "title": "채팅방"
  }
}

script:post-response {
  bru.setVar("chatId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  로그인 유저(member 1)와 member 7 간 채팅방을 생성한다. participantIds 는 본인 포함 필수.
  @seed members : 7
}
