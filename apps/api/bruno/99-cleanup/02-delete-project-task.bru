meta {
  name: 업체 작업 삭제
  type: http
  seq: 2
  tags: [
    chain
    idempotent
  ]
}

delete {
  url: {{baseUrl}}/api/v1/tasks/{{projectTaskId}}
  auth: inherit
}

vars:pre-request {
  projectTaskId: 200
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
