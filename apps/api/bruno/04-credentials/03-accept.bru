}

post {
  url: {{baseUrl}}/api/v1/credentials/:id/accept
  auth: inherit
}

params:path {
  id: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  어드민이 사용자가 업로드한 자격을 직접 검토한 다음 승인한다.
  @seed credentials : 100
}
