get {
  url: {{baseUrl}}/api/v1/credentials?memberId={{memberId}}
  auth: none
}

params:query {
  memberId: {{memberId}}
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

