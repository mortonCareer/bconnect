meta {
  name: 동료 요청 보내기
  type: http
  seq: 1
  tags: [
    seed
  ]
}

post {
  url: {{baseUrl}}/api/v1/coworker-requests
  auth: inherit
}

body {
  {
    "toId": 2
  }
}

script:post-response {
  bru.setVar("coworkerRequestId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  로그인 유저가 시드 프로필(2)에게 동료 요청을 생성한다.
  @seed members : 3
  @seed profiles : 2
}
