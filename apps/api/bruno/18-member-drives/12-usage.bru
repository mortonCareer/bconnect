meta {
  name: 드라이브 용량 조회
  type: http
  seq: 12
  tags: [
    seed
  ]
}

get {
  url: {{baseUrl}}/api/v1/drives/:id/usage
  auth: inherit
}

params:path {
  id: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.usedBytes).to.be.a('number');
    expect(res.body.data.limitBytes).to.be.a('number');
  });
}

docs {
  드라이브 용량 조회 (소유자에게 귀속)
  @seed drives : 100
}
