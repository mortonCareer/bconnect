meta {
  name: 드라이브 첨부 업로드
  type: http
  seq: 10
  tags: [
    seed
    idempotent
  ]
}

post {
  url: {{baseUrl}}/api/v1/drives/:id/attachments
  body: json
  auth: inherit
}

params:path {
  id: 100
}

body:json {
  {
    "attachmentIds": [112, 113]
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  @seed drives : 100
  @seed attachments : 112
  @seed attachments : 113
}
