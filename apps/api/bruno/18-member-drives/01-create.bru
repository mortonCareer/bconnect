meta {
  name: 개인 드라이브 생성
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/drives
  body: json
  auth: inherit
}

body:json {
  {
    "type": "PERSONAL",
    "title": "개인 드라이브"
  }
}

script:post-response {
  bru.setVar("memberDriveId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  개인(MEMBER) 드라이브 생성
}
