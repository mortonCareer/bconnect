meta {
  name: 드라이브 이미지 목록 조회
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/drives/:id/images
  auth: inherit
}

params:path {
  id: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  @seed drives : 100
  @seed attachments : 108
  @seed attachments : 109
}
