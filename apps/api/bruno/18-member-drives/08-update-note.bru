meta {
  name: 노트 수정
  type: http
  seq: 8
  tags: [
    chain
    idempotent
  ]
}

put {
  url: {{baseUrl}}/api/v1/notes/{{noteId}}
  body: json
  auth: inherit
}

body:json {
  {
    "content": "드라이브 노트 수정"
  }
}

vars:pre-request {
  noteId: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

