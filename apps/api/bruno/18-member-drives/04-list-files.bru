meta {
  name: 드라이브 파일 목록 조회
  type: http
  seq: 4
  tags: [
    seed
  ]
}

get {
  url: {{baseUrl}}/api/v1/drives/:id/files
  auth: inherit
}

params:path {
  id: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  @seed drives : 100
}
