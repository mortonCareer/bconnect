meta {
  name: 드라이브 이름 수정
  type: http
  seq: 5
  tags: [
    chain
    idempotent
  ]
}

put {
  url: {{baseUrl}}/api/v1/drives/{{memberDriveId}}/name
  body: json
  auth: inherit
}

body:json {
  {
    "title": "개인 드라이브 수정"
  }
}

vars:pre-request {
  memberDriveId: 100
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  @chain
  - 18-member-drives/01-create
}
