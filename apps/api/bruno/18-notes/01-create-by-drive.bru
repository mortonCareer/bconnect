meta {
  name: 드라이브 노트 생성
  type: http
  seq: 1
  tags: [
    chain
  ]
}

post {
  url: {{baseUrl}}/api/v1/notes?driveId={{memberDriveId}}
  auth: inherit
}

params:query {
  driveId: {{memberDriveId}}
}

body {
  {
    "content": "드라이브 노트"
  }
}

script:post-response {
  bru.setVar("noteId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  드라이브 보드에 노트 생성
  @chain
  - 17-drives/01-create-member
}
