meta {
  name: 프로젝트 노트 생성
  type: http
  seq: 2
  tags: [
    chain
  ]
}

post {
  url: {{baseUrl}}/api/v1/notes
  auth: inherit
}

body {
  {
    "type": "PROJECT",
    "projectId": {{projectId}},
    "content": "프로젝트 노트"
  }
}

script:post-response {
  bru.setVar("projectNoteId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  프로젝트 보드에 노트 생성
  @chain
  - 04-companies/01-create
  - 05-projects/01-create
}
