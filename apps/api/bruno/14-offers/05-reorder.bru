meta {
  name: 제안 순서 변경
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/offers/reorder
  auth: inherit
}

body {
  {
    "offerIds": [{{queuedOfferId}}]
  }
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

docs {
  업체가 대기열(PENDING) 제안의 순서를 일괄 변경한다. offerIds는 해당 작업의 PENDING 전체와 일치해야 한다.
}
