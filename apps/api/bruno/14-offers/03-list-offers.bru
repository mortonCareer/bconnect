meta {
  name: 섭외대기열 조회
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tasks/{{projectTaskId}}/offers
  auth: inherit
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  업체가 프로젝트 작업의 섭외대기열(제안 목록)을 seq 순으로 조회한다.
}
