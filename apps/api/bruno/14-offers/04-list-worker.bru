meta {
  name: 기술자 작업 목록 - 제안 포함
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/tasks
  auth: bearer
}

auth:bearer {
  token: {{profileToken}}
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  반장1(profileToken)의 작업 목록을 조회하면 받은 제안(OFFERED)이 합류되어 나온다.
}
