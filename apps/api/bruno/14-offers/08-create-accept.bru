meta {
  name: 제안 생성 - 승낙용
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/offers
  auth: inherit
}

body {
  {
    "taskId": {{projectTaskId}},
    "workerId": 2,
    "due": "2026-12-31"
  }
}

script:post-response {
  bru.setVar("acceptOfferId", res.body.data);
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.a('number');
  });
}

docs {
  활성 제안이 없는 상태에서 반장1(member 2)에게 다시 제안해 OFFERED로 만든다.
}
