meta {
  name: 프로젝트 작업 목록 조회
  type: http
  seq: 2
  tags: [
    chain
  ]
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/tasks
  body: none
  auth: inherit
}

vars:pre-request {
  projectId: 200
}

tests {
  test("성공", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  @chain
  - 05-companies/01-create
  - 06-projects/01-create
  - 07-company-tasks/01-create-company-task
}
