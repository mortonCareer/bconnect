{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(dir:*)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "WebSearch",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebFetch(domain:notion.so)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:notion.site)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew :core:test:*)",
      "Bash(grep:*)",
      "Bash(./gradlew compileJava)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [],
    "ask": []
  },
  "disabledMcpjsonServers": [
    "playwright",
    "figma",
    "aws"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/available-checker.sh"
          }
        ]
      }
    ]
  }
}
