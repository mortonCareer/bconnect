# Google Analytics 4 측정 ID (landing property, G-XXXXXXXXXX) — 발급 후 주석 해제.
# 미설정 시 GA 비활성 (Vercel Analytics 가 baseline).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 원클릭 조회용 Railway Postgres (KISCON 적재 데이터). career 와 동일 DB.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 국세청 사업자등록정보 API (data.go.kr)
NTS_API_SERVICE_KEY=your_data_go_kr_service_key

# 근로복지공단 고용/산재보험 API (data.go.kr)
KCOMWEL_API_SERVICE_KEY=your_data_go_kr_service_key
