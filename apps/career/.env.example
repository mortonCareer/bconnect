NEXT_PUBLIC_API_URL=https://api.example.com

# AWS (Lambda 호출용)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2

# 국세청 사업자등록정보 API (data.go.kr)
NTS_API_SERVICE_KEY=your_data_go_kr_service_key

# 근로복지공단 고용/산재보험 API (data.go.kr)
KCOMWEL_API_SERVICE_KEY=your_data_go_kr_service_key

# 고용24 임금체불 API (work24.go.kr) — 조직 승인 필요, 없으면 mock 사용
# WORK24_API_SERVICE_KEY=your_work24_api_service_key

# Vercel Cron 인증 시크릿 (Terraform으로 자동 생성)
CRON_SECRET=your_cron_secret

# Slack Incoming Webhook — 크롤링 스키마 변경 알림 (선택)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Firebase Cloud Messaging (Web Push) — 값은 Firebase 콘솔/Vercel(Terraform)에서. NEXT_PUBLIC = 클라 노출(공개 정보)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key