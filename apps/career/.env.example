NEXT_PUBLIC_API_URL=https://api.example.com

# API mocking (MSW) — dev/preview 에서 기본 ON (opt-out).
# 로컬에서 실 BE(dev API) 연동 테스트 시 'disabled' 로 바꾸면 MSW 우회 + 인증 가드 활성.
NEXT_PUBLIC_API_MOCKING=enabled

# Google Analytics 4 측정 ID (career property, G-XXXXXXXXXX) — 발급 후 주석 해제.
# 미설정 시 GA 비활성 (Vercel Analytics 가 baseline). 개인정보처리방침 GA 고지 선행 필요.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# AWS (Lambda 호출용)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2

# 국세청 사업자등록정보 API (data.go.kr)
NTS_API_SERVICE_KEY=your_data_go_kr_service_key

# 근로복지공단 고용/산재보험 API (data.go.kr)
KCOMWEL_API_SERVICE_KEY=your_data_go_kr_service_key

# 고용24 임금체불 API (work24.go.kr) — 조직 승인 필요, 없으면 mock 사용
# WORK24_API_SERVICE_KEY=your_work24_api_service_key

# Vercel Cron 인증 시크릿 (Terraform으로 자동 생성)
CRON_SECRET=your_cron_secret

# Slack Incoming Webhook — 모니터링 전용 채널, 원클릭 헬스체크 알림 (선택)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Firebase Cloud Messaging (Web Push). NEXT_PUBLIC = 클라 번들에 인라인되는 공개값이라 노출 안전:
#   apiKey      프로젝트 식별자 (비밀 아님 — 보안은 Firebase 규칙/App Check 담당)
#   authDomain  Auth 도메인 | projectId 프로젝트 ID | storageBucket Storage 버킷
#   messagingSenderId·appId  FCM 발신자/웹앱 식별자 | vapidKey Web Push 공개키(서명검증용 비밀키는 Firebase 보관, 별개)
# 단일 firebase 프로젝트라 값이 하나뿐 → placeholder 대신 실값 기재.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCfEFPtskdXcb1Wcf6x071lFEU6DN6tkM8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bconnect-f0bee.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bconnect-f0bee
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bconnect-f0bee.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=55671446261
NEXT_PUBLIC_FIREBASE_APP_ID=1:55671446261:web:0b74626dad6bc4a6fe43bc
