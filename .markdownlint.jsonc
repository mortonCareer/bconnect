// Morton docs markdown lint 룰 — docs-lint CI 가 이 파일을 SSoT 로 사용.
//
// 룰 의도: docs/how-to/write-docs.md 4장 안티패턴 차단 보조.
// markdownlint 의 default 룰 셋(MD001-MD059) 위에서 한국어 docs + Morton 표현 충돌 항목만
// 비활성/완화. 룰 번호는 https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md 참조.

{
  "default": true,

  // MD013 (line-length): 한국어 + 풍부한 table 셀에서 80자 한계가 비현실적.
  // 줄 길이 강제는 가독성 도구가 아닌 잡음 → 비활성 (Diátaxis 진영도 길이 룰 비강제).
  "MD013": false,

  // MD033 (no-inline-html): docs/reference/tools.md 가 table 셀에 <ul><li> 사용
  // (markdown native bullet 은 셀 안에서 줄바꿈 표현 한계). 비활성.
  "MD033": false,

  // MD024 (no-duplicate-heading): section 내 sibling 중복은 OK
  // (예: 여러 ADR 의 ## Context, ## Options, ## Decision 가 한 글에 같이 등장하는 일은 없음
  //  단, 같은 글 안에서 ### Step 1 같은 sub-heading 이 phase 별로 중복되는 경우 허용)
  "MD024": { "siblings_only": true },

  // MD034 (no-bare-urls): prettier 가 자동 링크화하므로 markdownlint 의 추가 검사 불필요
  // — 충돌 시 prettier 가 우선
  "MD034": false,

  // MD040 (fenced-code-language): 간혹 plain output(diff dump 등) 의 ``` 사용 허용
  "MD040": false,

  // MD036 (no-emphasis-as-heading): Morton docs 컨벤션이 짧은 sub-section 표시에
  // **굵은 글씨** 사용 다수 (table 셀, 섹션 강조 등). 정식 ## heading 강제는 비현실.
  "MD036": false,

  // MD049/MD050 (emphasis-style/strong-style): _ vs * 선택은 prettier 의 영역
  // markdownlint 가 또 검사하면 충돌 → 비활성
  "MD049": false,
  "MD050": false,
}
